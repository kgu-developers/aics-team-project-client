# Local development calls the real API through the Vite development proxy.
# Shared defaults are in .env.development; copy this to .env.development.local
# only when a personal override is needed. VITE_* values are public.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_OPEN_CHAT_URL=https://open.kakao.com/o/s38nlZNi
