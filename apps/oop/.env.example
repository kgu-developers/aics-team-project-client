VITE_API_BASE_URL=http://localhost:8080
VITE_APP_ENV=local

# Public HTTPS inquiry URL. Empty renders a disabled footer label.
# Vite reads this at build time; rebuild after changing it.
VITE_OPEN_CHAT_URL=https://open.kakao.com/o/s38nlZNi

# Set false to use the development backend through the Vite proxy.
VITE_ENABLE_MSW=true
