{
  "name": "@aics/oop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "pnpm build && wrangler pages deploy ./dist --project-name aics-oop --branch main --profile kgu-oop",
    "deploy:worker": "pnpm build && wrangler deploy --config wrangler.worker.jsonc --profile kgu-oop",
    "deploy:worker:dry-run": "pnpm build && wrangler deploy --dry-run --config wrangler.worker.jsonc --profile kgu-oop",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@aics/api-client": "workspace:*",
    "@aics/core": "workspace:*",
    "@aics/design-system": "workspace:*",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-query-devtools": "^5.74.6",
    "@tanstack/react-router": "^1.114.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@vanilla-extract/css": "^1.17.1",
    "axios": "^1.13.2",
    "lucide-react": "^0.503.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.56.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aics/typescript": "workspace:*",
    "@tanstack/router-devtools": "^1.114.3",
    "@tanstack/router-plugin": "^1.114.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vanilla-extract/vite-plugin": "^5.0.1",
    "@vitejs/plugin-react": "^4.4.2",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "4.127.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
